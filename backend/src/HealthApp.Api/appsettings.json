{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=HealthAppDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "HealthApp.Api",
    "Audience": "HealthApp.Web",
    "Key": "CHANGE_THIS_DEVELOPMENT_KEY_TO_A_LONG_RANDOM_SECRET_1234567890",
    "Minutes": 60
  },
  "PlatformFees": {
    "CustomerServiceFeePercent": 5
  },
  "Tax": {
    "RestaurantGstRate": 5,
    "PlatformServiceGstRate": 18
  },
  "Email": {
    "Enabled": true,
    "Host": "smtpout.secureserver.net",
    "Port": 465,
    "EnableSsl": true,
    "Username": "lasya@broccoly.in",
    "Password": "",
    "FromAddress": "lasya@broccoly.in",
    "FromName": "Broccoly",
    "ReplyToAddress": "support@broccoly.in",
    "AdminNotificationAddress": "lasya@broccoly.in",
    "SupportAddress": "support@broccoly.in",
    "OutletAdminUrl": "http://localhost:5174",
    "TimeoutSeconds": 20
  },
  "TenantDomains": {
    "PlatformBaseDomain": "broccoly.in"
  },
  "CloudflarePages": {
    "Enabled": false,
    "AccountId": "",
    "ProjectName": "healthapp-customer",
    "ApiToken": ""
  },
  "Demo": {
    "OutletPortalUrl": "http://localhost:5174"
  },
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Routing": {
    "OsrmBaseUrl": "https://router.project-osrm.org"
  },
  "Storage": {
    "Provider": "Local",
    "Container": "healthapp-media",
    "ConnectionString": "",
    "AccountUrl": "",
    "PublicBaseUrl": "",
    "LocalRoot": "wwwroot/uploads",
    "PrivateContainer": "healthapp-private",
    "PrivateLocalRoot": "App_Data/private-uploads"
  },
  "Media": {
    "MaxImageUploadBytes": 10000000,
    "MaxImageDimension": 5000,
    "WebpQuality": 82,
    "ThumbnailQuality": 76
  },
  "Geocoding": {
    "Provider": "Nominatim",
    "BaseUrl": "https://nominatim.openstreetmap.org",
    "UserAgent": "HealthApp/1.0 (+https://healthapp.example)",
    "Referer": ""
  },
  "PaymentRetry": {
    "Enabled": true,
    "PollIntervalSeconds": 15,
    "MaxAttempts": 6,
    "BatchSize": 20
  },
  "Cashfree": {
    "Enabled": false,
    "Environment": "Sandbox",
    "ClientId": "",
    "ClientSecret": "",
    "ApiVersion": "2025-01-01",
    "BaseUrl": "",
    "OutletReturnUrl": "https://broccoly.in/payment",
    "WebhookUrl": "https://api.broccoly.in/api/payments/webhook"
  }
}
