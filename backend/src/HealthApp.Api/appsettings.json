{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=HealthAppDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Jwt": {
    "Issuer": "HealthApp.Api",
    "Audience": "HealthApp.Web",
    "Key": "CHANGE_THIS_DEVELOPMENT_KEY_TO_A_LONG_RANDOM_SECRET_1234567890",
    "Minutes": 60
  },
  "PlatformFees": {
    "CustomerServiceFeePercent": 3
  },
  "Tax": {
    "RestaurantGstRate": 5,
    "PlatformServiceGstRate": 18
  },
  "Email": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "HealthApp"
  },
  "TenantDomains": {
    "PlatformBaseDomain": "healthapp.com"
  },
  "CloudflarePages": {
    "Enabled": false,
    "AccountId": "",
    "ProjectName": "healthapp-customer",
    "ApiToken": ""
  },
  "Demo": {
    "OutletPortalUrl": "http://localhost:5175"
  },
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Routing": {
    "OsrmBaseUrl": "https://router.project-osrm.org"
  },
  "Storage": {
    "Provider": "Local",
    "Container": "healthapp-media",
    "ConnectionString": "",
    "AccountUrl": "",
    "PublicBaseUrl": "",
    "LocalRoot": "wwwroot/uploads"
  },
  "Geocoding": {
    "Provider": "Nominatim",
    "BaseUrl": "https://nominatim.openstreetmap.org",
    "UserAgent": "HealthApp/1.0 (+https://healthapp.example)",
    "Referer": ""
  }
}
